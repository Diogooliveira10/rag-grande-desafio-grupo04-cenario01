# Configurações de API / Server URL
OLLAMA_URL=http://ecoa-llm.duckdns.org:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_LOCAL_URL=http://localhost:11434/v1
OLLAMA_LOCAL_API_KEY=ollama
OLLAMA_LOCAL_EMBEDDING_MODEL=xagi/qwen3-embedding:0.6b-q4_k_m
# Alternativa local (defesa contra indisponibilidade do endpoint da turma):
# llama-server em 127.0.0.1:18321 com o GGUF do Qwen3-Embedding-0.6B
# (scripts/models.ps1 baixa e imprime o comando):
#   EMBEDDING_PROVIDER=ollama
#   OLLAMA_LOCAL_URL=http://127.0.0.1:18321/v1
#   OLLAMA_LOCAL_EMBEDDING_MODEL=Qwen3-Embedding-0.6B.Q8_0

# Modelos
GENERATION_MODEL=qcwind/qwen3-8b-instruct-Q4-K-M
EMBEDDING_MODEL=xagi/qwen3-embedding:0.6b-q4_k_m
# Provedor dos embeddings de CONSULTA (src/retrieve.py): ecoa (padrão,
# compartilhado), ollama (llama.cpp/Ollama local), openai ou custom. Só muda
# quem embeda a PERGUNTA; os vetores dos documentos são os do índice e não são
# reembedados por causa disso. O cache de query separa por endpoint e modelo.
EMBEDDING_PROVIDER=ecoa

# Orçamento do contexto na geração. Janela curta (endpoint da turma, 2048
# tokens): 3500. OpenRouter (janela grande): 12000, para o top-k inteiro caber.
# Sem esta variável, o padrão acompanha o LLM_PROVIDER_MODE.
# GENERATION_CONTEXT_CHARS=12000
GENERATION_CHUNK_CHARS=900
# Tempo máximo (s) de cada chamada de geração e novas tentativas.
GENERATION_TIMEOUT=180
GENERATION_MAX_RETRIES=1

# Rerank por cross-encoder local (src/rerank.py). Na primeira vez o modelo
# (~470 MB) é baixado para o cache do Hugging Face. false = só RRF.
RERANK_ENABLED=true
# local = cross-encoder local (padrão, melhor na ablação de 07/10);
# ecoa = endpoint /api/rerank da turma (cai no cross-encoder local se falhar).
RERANK_PROVIDER=local
# Vazio = derivado de OLLAMA_URL (http://ecoa-llm.duckdns.org:11434/api/rerank).
RERANK_URL=
RERANK_TIMEOUT=30
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_CANDIDATES=10
RERANK_MAX_LENGTH=512

# Presets opcionais de APIs OpenAI-compatible
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CUSTOM_API_URL=
CUSTOM_API_KEY=
CUSTOM_EMBEDDING_MODEL=xagi/qwen3-embedding:0.6b-q4_k_m

# Coleta e armazenamento
REQUEST_TIMEOUT=30
REQUEST_ATTEMPTS=3

# OCR de PDFs escaneados (Tesseract). Vazio = procura no PATH e em
# C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANG=por
OCR_DPI=300

# Base estruturada em SQL (src/structured_db.py). Vazio = SQLite local em
# data/structured/. Para usar Postgres (ex.: Neon), cole a connection string
# do painel do Neon, no formato:
# DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# API HTTP (app/api.py): origens extras liberadas no CORS, separadas por vírgula.
# localhost:5173 e 127.0.0.1:5173 (Vite) já são permitidas por padrão.
CORS_ALLOW_ORIGINS=https://etuarda.github.io
# Chave administrativa dos traces (header X-API-Key); sem ela, só o dono da
# sessão via X-Session-Id. Histórico geral temporariamente aberto para a demo.
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_API_KEY=
# Dias que o histórico guarda cada consulta; 0 = sem expurgo.
HISTORY_RETENTION_DAYS=30
# Logs do pipeline: dias de retenção (0 = sem expurgo); sem esta variável,
# acompanha HISTORY_RETENTION_DAYS. A limpeza ocorre na primeira escrita diária.
LOG_RETENTION_DAYS=30
# resumo = candidatos/SQL compactos (padrão); completo = todas as evidências
# retornadas, resultado SQL e prompt mascarados, sem mudar o orçamento do LLM.
# Reinicie a aplicação após mudar. O modo completo ocupa mais espaço em disco.
LOG_EVIDENCE_DETAIL=resumo
# Relatórios de manutenção e temporários de testes falhos; limpeza explícita:
# python -m src.log_maintenance cleanup --apply
MAINTENANCE_RETENTION_DAYS=14

# Análise experimental por LLM: habilitar explicitamente após avaliar qualidade.
# O padrão preserva o analisador por regras; respostas continuam usando ECOA.
QUERY_ANALYSIS_MODE=regras
MODEL_MIN_INTERVAL_SECONDS=10

# ECOA principal + fallback OpenRouter. Chave somente no .env local.
OPENROUTER_API_KEY=
OPENROUTER_MAX_TOKENS=4096
# auto = ECOA com fallback; openrouter = somente OpenRouter para LLM.
# O modo não troca o modelo/endpoint dos embeddings das perguntas.
LLM_PROVIDER_MODE=auto
# Modelo preferido das chamadas OpenRouter e reserva quando ele estiver
# indisponível (rede/timeout/404/408/429/5xx). Erros de entrada não trocam de
# modelo. Sem configurar, o padrão mantém "openrouter/free" nos dois.
# Exemplo de configuração de respostas: OPENROUTER_MODEL=xiaomi/mimo-v2.6-flash
# com OPENROUTER_MODEL_FALLBACK=openrouter/free.
OPENROUTER_MODEL=
OPENROUTER_MODEL_FALLBACK=
# Identificação de mensagens longas/comuns: llm ou regras (só cortesia direta).
CONVERSATION_MODE=llm
# Reescrita de perguntas de continuação ("os mesmos contratos", "E em 2024?") com o
# historico enviado pelo cliente: llm ou regras (desliga; o historico e' ignorado).
REFORMULACAO_MODE=llm
